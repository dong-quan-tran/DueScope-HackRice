# Backend
APP_ENV=development
DEBUG=true
API_PUBLIC_URL=http://127.0.0.1:8001
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///backend/duescope.db

# Frontend (put this in frontend/.env.local for local development)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# Canvas
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# Google OAuth / Calendar / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/google/auth/callback

# Optional AI extraction
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
